    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32 Debug (DAP)",
            "type": "cortex-debug",
            "serverpath": "openocd",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/board/build/Debug/board.elf", //todo 改为真实elf
            //"preLaunchTask": "cmake-build-debug",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg" //todo?
                //"target/stm32h7x.cfg"
            ],
            "runToEntryPoint": "main",
            "device": "STM32F407IGHx",//todo C板是 STM32F407IGH6
            //"device": "STM32H723VGTx",
            "breakAfterReset": true,//新增：每次启动复位后停在 main，保证 main 里的断点能命中
            //"liveWatch": {   //排障期间关掉：Live Watch 会开第二个 gdb 会话在后台复位目标，导致主会话断点不命中
            //    "enabled": true,
            //    "samplesPerSecond": 20
            //},
            "svdFile": "D:/software/STM32CubeCLT_1.19.0/STMicroelectronics_CMSIS_SVD/STM32F407.svd" //已改：F407 的 SVD（外设寄存器视图）
        },

        {
            "name": "STM32 Debug (STLink)",
            "type": "cortex-debug",
            "serverpath": "openocd",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/board/build/Debug/board.elf", //todo 改为真实elf
            //"preLaunchTask": "cmake-build-debug",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            //"device": "STM32H723VGTx",
            "device": "STM32F407IGHx",//todo C 板是 STM32F407IGH6
            "breakAfterReset": true,//新增：每次启动复位后停在 main
            //"liveWatch": {   //排障期间关掉：同上
            //    "enabled": true,
            //    "samplesPerSecond": 20
            //},
        },

    ]
}